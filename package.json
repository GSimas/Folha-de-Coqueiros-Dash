{
  "name": "folha-de-coqueiros-dash",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Dashboard de inteligência territorial e jornalismo local da Folha de Coqueiros (SNA + CLD + assistente de IA)",
  "scripts": {
    "sync:data": "node scripts/sync-data.mjs",
    "dev": "vite",
    "prebuild": "npm run sync:data",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "avaliar": "vitest run tests/avaliacao.live.test.ts --reporter=verbose"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "@xyflow/react": "^12.11.5",
    "dagre": "^0.8.5",
    "lucide-react": "^1.37.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "vis-data": "^8.0.5",
    "vis-network": "^10.1.2"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.54",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.3"
  }
}
